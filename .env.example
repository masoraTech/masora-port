DATABASE_URL="postgresql://postgres:xxxxxxx@localhost:xxxx/portfolio?schema=public"
# Mot de passe de la page /admin
ADMIN_EMAIL="xxxxx"
ADMIN_PASSWORD="xxxxxxxxx"
# Chaîne aléatoire longue (openssl rand -hex 32)
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Les images téléversées sont stockées dans Netlify Blobs (store "uploads")
# Mettre "false" si vous servez le site en HTTP (sans HTTPS)
COOKIE_SECURE="true"
